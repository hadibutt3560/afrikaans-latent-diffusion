#!/usr/bin/env bash
# Copy to longrun.env and edit. User confirmed account/partition/exclusive/72h.
export ACCOUNT=general
export PARTITION=biggpu
export REPO="$HOME/research-afrikaans-longrun-20261002"
export BASE="$HOME/research-afrikaans-24h"
export DATA="$REPO/data/nchlt_afrikaans/processed/stage_5_7"
export AE="$BASE/outputs/afrikaans-24h-56531/best"
export MODEL_CACHE="$BASE/models/mt5-base"
export SIF="$HOME/containers/anaconda-2025-12-2.sif"
export PY="$HOME/.conda/envs/ld4lg-blackwell/bin/python"
export CONFIG="$REPO/configs/afrikaans_longrun.json"
# REQUIRED: approved persistent/shared directory, NOT node-local temporary space.
export WORKSPACE="REPLACE_WITH_ABSOLUTE_PERSISTENT_PATH/afrikaans-longrun-20261002"
# Keep resource syntax from the existing Wits exclusive allocation (null GRES).
# After benchmark, constrain to that GPU model using a VERIFIED node/constraint.
# Example syntax only: RESOURCE_ARGS=(--exclusive --nodelist=VERIFIED_HEALTHY_NODE)
RESOURCE_ARGS=(--exclusive)
# Historical failures: mscluster107,108,111. Check with admins before using them.
# Optional after verification: RESOURCE_ARGS+=(--exclude=mscluster107,mscluster108,mscluster111)
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export CPUS=4
export MEMORY=64G
